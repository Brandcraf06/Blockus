{
  "multipart": [
    {
      "apply": {
        "model": "blockus:block/road_barrier_post"
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side"
      },
      "when": {
        "north": "low"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side",
        "y": 90
      },
      "when": {
        "east": "low"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side",
        "y": 180
      },
      "when": {
        "south": "low"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side",
        "y": 270
      },
      "when": {
        "west": "low"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side"
      },
      "when": {
        "north": "tall"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side",
        "y": 90
      },
      "when": {
        "east": "tall"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side",
        "y": 180
      },
      "when": {
        "south": "tall"
      }
    },
    {
      "apply": {
        "model": "blockus:block/road_barrier_side",
        "y": 270
      },
      "when": {
        "west": "tall"
      }
    }
  ]
}